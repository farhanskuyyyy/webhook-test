# Salin file ini menjadi .env lalu isi password admin sendiri.
# Password wajib minimal 16 karakter. Jangan commit file .env.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-a-random-password-at-least-16-characters

# Gunakan true jika login CMS diakses melalui HTTPS.
ADMIN_COOKIE_SECURE=false

# Kosong saat belum dikonfigurasi. Jika memakai reverse proxy,
# isi dengan IP/CIDR proxy yang benar-benar terhubung ke container.
TRUSTED_PROXIES=

GEOIP_AUTO_DOWNLOAD=true
